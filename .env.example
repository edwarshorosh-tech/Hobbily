# Local environment variables for the Expo client — copy this file to `.env`
# (same directory) and fill in real values. `.env` is gitignored and never
# committed; every developer creates their own copy locally. Metro/Expo
# automatically inlines any EXPO_PUBLIC_* variable into process.env at bundle
# time (Expo SDK 49+) — no extra app.config wiring is required. After adding
# or changing a value here, restart Metro (a hot reload is not enough,
# since these are resolved at bundle time, not read at runtime).
#
# Both variables below are client-safe public URLs/keys, never secrets — the
# real provider credentials (Gemini, OpenWeatherMap) live only on the server
# side (see worker/wrangler.toml's "Secret configuration" section) and must
# never be added here or committed anywhere in this repo.

EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key_here

# REQUIRED for the Home AI Assistant (services/aiAssistantService.ts /
# AIAssistantCard in app/(tabs)/index.tsx). Public URL of the deployed
# Cloudflare Worker (worker/) that proxies the conversation to Gemini —
# this is just a URL, not a secret. The actual Gemini API key
# (GEMINI_API_KEY) lives only as a Cloudflare secret, set with
# `wrangler secret put GEMINI_API_KEY` inside worker/, never here.
#
# Without this set, isAiAssistantConfigured is false and every AI Assistant
# message shows "The AI assistant isn't set up yet. Add activities manually
# for now." — that is expected, correct client-side behavior for a missing
# local .env, not a bug. Ask a teammate for the team's deployed Worker URL,
# or deploy your own with `wrangler deploy` from worker/ and use that URL.
# Must include the /chat route.
EXPO_PUBLIC_AI_WORKER_URL=https://hobbily-ai-worker.your-subdomain.workers.dev/chat
