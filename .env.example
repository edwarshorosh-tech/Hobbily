EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key_here

# REQUIRED for the Home AI Assistant's scheduling feature (services/aiAssistantService.ts).
# Public URL of the deployed Cloudflare Worker (worker/) that proxies free-text
# scheduling requests to Hugging Face. This is just a URL, not a secret — the
# actual Hugging Face token (HF_TOKEN) lives only as a Cloudflare secret,
# set with `wrangler secret put HF_TOKEN` inside worker/, never here.
# Without this set, "when am I free?" questions and exam mentions still work
# (handled locally by services/aiService.ts), but plain scheduling requests
# ("Soccer practice tomorrow at 7pm") will show a "not set up yet" message —
# see isAiAssistantConfigured in services/aiAssistantService.ts.
EXPO_PUBLIC_AI_WORKER_URL=https://hobbily-ai-worker.your-subdomain.workers.dev/parse-activity
