rules_version = '2';

// ═════════════════════════════════════════════════════════════════════════
// ⚠️  WARNING — VERIFY AGAINST THE CONSOLE BEFORE RUNNING A FULL DEPLOY  ⚠️
// ═════════════════════════════════════════════════════════════════════════
// This project had no firestore.rules under version control prior to this
// change (rules were only ever configured directly in the Firebase Console).
//
// `friendships`, `publicProfiles`, `users/{uid}/notifications`,
// `communityMemberships`, `channels/{channelId}/messages`, `posts`
// (including its `comments` subcollection), and `users/{uid}/likedPostIds` /
// `users/{uid}/likedCommentIds` below are complete, tested rules written for
// those features — no action needed.
//
// `users` and `progress` are a signed-in-only BASELINE (any authenticated
// user may read/write), added solely so deploying this file doesn't lock
// every user out of their own data. This baseline is intentionally coarse —
// e.g. `users/{uid}` is NOT yet restricted to its own owner — and is NOT a
// substitute for whatever rules are already live in the Console.
//
// BEFORE running `firebase deploy --only firestore:rules`:
//   1. Open Firebase Console → Firestore Database → Rules and compare
//      against the four baseline blocks marked "BASELINE" below.
//   2. If the live Console rules are stricter (e.g. owner-only reads/writes),
//      port those exact conditions in instead of leaving the baseline as-is.
//   3. Only then deploy.
// Deploying this file REPLACES the entire ruleset — skipping this check
// risks silently loosening production access control.
// ═════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Friendships ──────────────────────────────────────────────────────────
    // friendships/{pairId} — pairId is "<uidA>_<uidB>" with uidA < uidB.
    match /friendships/{friendshipId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // The doc id must be exactly the two participant UIDs, sorted, joined with "_".
      function isValidPairId(id, uidA, uidB) {
        return id == (uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA);
      }

      function isValidNewFriendship() {
        let data = request.resource.data;
        return data.requestedBy == request.auth.uid
          && data.requestedTo != request.auth.uid
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] < data.participants[1]
          && data.participants[0] in [data.requestedBy, data.requestedTo]
          && data.participants[1] in [data.requestedBy, data.requestedTo]
          && isValidPairId(friendshipId, data.requestedBy, data.requestedTo)
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.acceptedAt == null
          && data.declinedAt == null;
      }

      // A participant may only read their own friendship documents.
      allow read: if isParticipant();

      // Only the requester may create a new pending request, and only for
      // themself → someone else (never for a third party, never for self).
      allow create: if isSignedIn() && isValidNewFriendship();

      // Updates are restricted to specific, valid status transitions.
      // participants/requestedBy/requestedTo/createdAt are immutable after
      // creation in every branch below.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.requestedBy in resource.data.participants
        && request.resource.data.requestedTo in resource.data.participants
        && request.resource.data.requestedBy != request.resource.data.requestedTo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          // Recipient accepts a pending request.
          (resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.auth.uid == resource.data.requestedTo
            && request.resource.data.requestedBy == resource.data.requestedBy
            && request.resource.data.requestedTo == resource.data.requestedTo
            && request.resource.data.acceptedAt == request.time
            && request.resource.data.declinedAt == resource.data.declinedAt)

          // Recipient declines a pending request.
          || (resource.data.status == 'pending'
            && request.resource.data.status == 'declined'
            && request.auth.uid == resource.data.requestedTo
            && request.resource.data.requestedBy == resource.data.requestedBy
            && request.resource.data.requestedTo == resource.data.requestedTo
            && request.resource.data.declinedAt == request.time
            && request.resource.data.acceptedAt == resource.data.acceptedAt)

          // Sender cancels their own pending outgoing request.
          || (resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.auth.uid == resource.data.requestedBy
            && request.resource.data.requestedBy == resource.data.requestedBy
            && request.resource.data.requestedTo == resource.data.requestedTo
            && request.resource.data.acceptedAt == resource.data.acceptedAt
            && request.resource.data.declinedAt == resource.data.declinedAt)

          // A participant re-opens a declined/cancelled pair with a fresh
          // request — requestedBy/requestedTo may change direction, but only
          // between the same two participants.
          || ((resource.data.status == 'declined' || resource.data.status == 'cancelled')
            && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.acceptedAt == null
            && request.resource.data.declinedAt == null)
        );

      // Removing an accepted friendship: either participant, only while accepted.
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && resource.data.status == 'accepted';
    }

    // ── Public profiles ──────────────────────────────────────────────────────
    // publicProfiles/{uid} — safe-to-read-by-any-authenticated-user subset of
    // the private users/{uid} document. Kept in sync by ProfileContext
    // (username/city/bio/hobbies) and ProgressContext (currentStreak) — see
    // the note below. bio/hobbies were added for UserCardSheet (Stage 9) —
    // deliberately still no age, email, or exact location here, ever.
    match /publicProfiles/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // The ids this user's own progress doc says are actually unlocked —
      // used below so featuredAchievementIds can't claim an achievement the
      // user hasn't earned. Guarded with exists()/'in' checks since a brand
      // new account (or one that hasn't loaded ProgressContext's one-time
      // reconciliation backfill yet — see ProgressContext.tsx) may have no
      // progress doc, or one predating the achievementIds mirror field.
      function unlockedAchievementIds() {
        return exists(/databases/$(database)/documents/progress/$(uid))
          && 'state' in get(/databases/$(database)/documents/progress/$(uid)).data
          && 'achievementIds' in get(/databases/$(database)/documents/progress/$(uid)).data.state
          ? get(/databases/$(database)/documents/progress/$(uid)).data.state.achievementIds
          : [];
      }

      function isValidFeaturedAchievements(data) {
        return !('featuredAchievementIds' in data)
          || (
            data.featuredAchievementIds is list
            && data.featuredAchievementIds.size() <= 3
            && data.featuredAchievementIds.toSet().difference(unlockedAchievementIds().toSet()).size() == 0
          );
      }

      // Both keys are always written together (see services/profileService.ts)
      // — either both null (quiz not completed, or the user has
      // showPersonalityType off) or both a real, known result. typeId is
      // checked against the fixed set utils/quizScoring.ts can actually
      // produce (4 single-letter archetypes, 6 two-way hybrids, or
      // "renaissance" for a 3+-way tie) so a client can't write an
      // arbitrary/fabricated personality type here.
      function isValidPersonalityType(data) {
        return (('personalityTypeId' in data) == ('personalityTypeName' in data))
          && (
            !('personalityTypeId' in data)
            || (data.personalityTypeId == null && data.personalityTypeName == null)
            || (
              data.personalityTypeId is string
              && data.personalityTypeId in ['A', 'B', 'C', 'D', 'AB', 'AC', 'AD', 'BC', 'BD', 'CD', 'renaissance']
              && data.personalityTypeName is string
              && data.personalityTypeName.size() > 0 && data.personalityTypeName.size() <= 60
            )
          );
      }

      function isValidPublicProfile() {
        let data = request.resource.data;
        return data.uid == uid
          && data.username is string && data.username.size() > 0 && data.username.size() <= 40
          && data.usernameNormalized is string
          && data.usernameNormalized == data.username.lower()
          && data.city is string && data.city.size() <= 60
          && (data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
          && (data.currentStreak is int || data.currentStreak is float) && data.currentStreak >= 0
          && data.bio is string && data.bio.size() <= 300
          && data.hobbies is list && data.hobbies.size() <= 20
          && data.updatedAt == request.time
          && isValidFeaturedAchievements(data)
          && isValidPersonalityType(data)
          // No extra/private fields — only this exact allow-listed shape.
          && data.keys().hasOnly(
            ['uid', 'username', 'usernameNormalized', 'city', 'avatarUrl', 'currentStreak', 'bio', 'hobbies', 'featuredAchievementIds', 'personalityTypeId', 'personalityTypeName', 'updatedAt']
          );
      }

      // Any signed-in user can read public profiles (needed for search/leaderboard).
      allow read: if request.auth != null;

      // Only the owner may create/update their own public profile, and only
      // with the allow-listed shape above — this is what keeps private
      // users/{uid} fields (email, age, bio, ...) out of publicProfiles.
      //
      // SECURITY NOTE: currentStreak is written by the same authenticated
      // client that owns progress/{uid} today (see ProgressContext) — this
      // rule preserves that existing trust boundary rather than silently
      // introducing a stricter one. A malicious client could misreport its
      // own streak here exactly as it already could in progress/{uid}; this
      // is a pre-existing limitation, not one introduced by this change.
      //
      // SECURITY NOTE: featuredAchievementIds IS enforced to be a subset of
      // this same user's progress/{uid}.state.achievementIds — see
      // isValidFeaturedAchievements() above — so it can't reference an
      // achievement id that user's own progress doc doesn't list as
      // unlocked. That's real protection against fabricating a *display*
      // claim, but it's only as strong as achievements themselves are: since
      // progress/{uid} has no server-side verification of *how* an
      // achievement was unlocked (same limitation as currentStreak, just
      // above), a client could still write itself an unearned achievement
      // there first and then legitimately feature it here. Closing that
      // would require a trusted backend (Cloud Functions) evaluating
      // achievement conditions server-side — none exists in this project.
      allow create, update: if isOwner() && isValidPublicProfile();

      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    // users/{recipientId}/notifications/{notificationId} — a user's own
    // notification inbox. No Cloud Functions or trusted backend exist in this
    // project (see README/final report), so creation happens client-side,
    // tightly validated against real backing data via get() so a client can
    // only create a notification for an event it just legitimately caused.
    // `system_message` (and any type outside the three branches below) can
    // NOT be created by any client — there is no rule branch permitting it —
    // satisfying "no arbitrary client may create system messages for others."
    match /users/{recipientId}/notifications/{notificationId} {
      function isRecipient() {
        return request.auth != null && request.auth.uid == recipientId;
      }

      function friendshipPairId(uidA, uidB) {
        return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
      }

      function isValidRoute() {
        let r = request.resource.data.route;
        return r == null
          || (r.keys().hasOnly(['screen'])
              && r.screen in ['profile_friends_requests', 'profile_friends', 'profile_badges']);
      }

      function isValidBaseShape() {
        let data = request.resource.data;
        return data.recipientId == recipientId
          && data.actorId == request.auth.uid
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.body is string && data.body.size() <= 500
          && (data.entityId == null || data.entityId is string)
          && isValidRoute()
          && data.isRead == false
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.keys().hasOnly(
            ['recipientId', 'type', 'title', 'body', 'actorId', 'entityId', 'route', 'isRead', 'createdAt', 'updatedAt']
          );
      }

      // A client may create a "you got a friend request" notification for
      // someone else only if it just created that exact pending request.
      function isValidFriendRequestReceived() {
        let fs = get(/databases/$(database)/documents/friendships/$(friendshipPairId(request.auth.uid, recipientId))).data;
        return request.resource.data.type == 'friend_request_received'
          && fs.status == 'pending'
          && fs.requestedBy == request.auth.uid
          && fs.requestedTo == recipientId;
      }

      // A client may create a "your request was accepted" notification for
      // the original sender only if it (the recipient) just accepted that
      // exact friendship.
      function isValidFriendRequestAccepted() {
        let fs = get(/databases/$(database)/documents/friendships/$(friendshipPairId(request.auth.uid, recipientId))).data;
        return request.resource.data.type == 'friend_request_accepted'
          && fs.status == 'accepted'
          && fs.requestedTo == request.auth.uid
          && fs.requestedBy == recipientId;
      }

      // Achievement notifications are always self-notifications.
      function isValidAchievementUnlocked() {
        return request.resource.data.type == 'achievement_unlocked' && request.auth.uid == recipientId;
      }

      allow read: if isRecipient();

      allow create: if request.auth != null
        && isValidBaseShape()
        && (isValidFriendRequestReceived() || isValidFriendRequestAccepted() || isValidAchievementUnlocked());

      // Only the recipient, and only isRead/updatedAt may ever change —
      // recipientId/type/actorId/title/body/route are immutable after creation.
      allow update: if isRecipient()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ── Community membership ──────────────────────────────────────────────────
    // communityMemberships/{channelId}_{uid} — the real, server-side record
    // of "this user is in this channel" (see services/communityService.ts).
    // The deterministic doc ID is the uniqueness constraint: a second "join"
    // is a re-write of the exact same doc, never a new one, so double-tap
    // and multi-device joins can never create duplicates.
    match /communityMemberships/{membershipId} {
      function isSignedIn() { return request.auth != null; }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'joined'
        && membershipId == request.resource.data.channelId + '_' + request.auth.uid
        && request.resource.data.username is string;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    // ── Posts, comments, likes ────────────────────────────────────────────────
    // posts/{postId} holds content only — comments and likes are
    // subcollections (below), never inline arrays, specifically so each
    // comment/like is independently ownable by rules. likeCount/commentCount
    // are denormalized counters kept in sync by services/postsService.ts's
    // transactions; the rules below independently bound how they can move
    // rather than trusting whatever number a client sends.
    match /posts/{postId} {
      function isSignedIn() { return request.auth != null; }
      function isNewAuthor() { return isSignedIn() && request.resource.data.authorId == request.auth.uid; }
      function wasAuthor() { return isSignedIn() && resource.data.authorId == request.auth.uid; }

      function isValidNewPost() {
        let data = request.resource.data;
        return data.authorId == request.auth.uid
          && data.username is string && data.username.size() > 0 && data.username.size() <= 40
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.body is string && data.body.size() <= 5000
          && data.tags is list
          && data.likeCount == 0
          && data.commentCount == 0
          && data.createdAt is string;
      }

      // A non-author may only ever move likeCount by exactly 1, and only in
      // the direction that matches their own likedPostIds doc now existing.
      // existsAfter() sees the state including this same transaction's other
      // writes, which is what actually ties the counter to a real like doc
      // (services/postsService.ts's togglePostLike creates/deletes both in
      // one transaction) instead of trusting a bare number from the client.
      function isValidLikeToggle() {
        let likeDoc = /databases/$(database)/documents/users/$(request.auth.uid)/likedPostIds/$(postId);
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1 && existsAfter(likeDoc))
            || (request.resource.data.likeCount == resource.data.likeCount - 1 && !existsAfter(likeDoc))
          );
      }

      // commentCount can't be tied to one specific comment doc the same way
      // a like can (this rule has no way to know which commentId a given
      // write is "for"). Bounded to a ±1 step by any signed-in user — enough
      // to stop a client setting it to an arbitrary number, not a full proof
      // the step came from a real comment create/delete. This project has no
      // trusted backend (no Cloud Functions) to close that gap fully — same
      // documented limitation as publicProfiles.currentStreak above.
      function isValidCommentCountStep() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
              || request.resource.data.commentCount == resource.data.commentCount - 1);
      }

      allow read: if isSignedIn();
      allow create: if isNewAuthor() && isValidNewPost();
      allow update: if (wasAuthor() && request.resource.data.authorId == resource.data.authorId)
        || isValidLikeToggle()
        || isValidCommentCountStep();
      allow delete: if wasAuthor();
    }

    match /posts/{postId}/comments/{commentId} {
      function isSignedIn() { return request.auth != null; }
      function isNewCommentAuthor() { return isSignedIn() && request.resource.data.authorId == request.auth.uid; }
      function wasCommentAuthor() { return isSignedIn() && resource.data.authorId == request.auth.uid; }

      function isValidNewComment() {
        let data = request.resource.data;
        return data.postId == postId
          && data.authorId == request.auth.uid
          && data.username is string && data.username.size() > 0
          && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
          && (data.parentCommentId == null || data.parentCommentId is string)
          && data.likeCount == 0
          && data.createdAt is string;
      }

      function isValidOwnEdit() {
        return wasCommentAuthor()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.parentCommentId == resource.data.parentCommentId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.likeCount == resource.data.likeCount;
      }

      // Same existsAfter-bound pattern as posts/{postId}'s isValidLikeToggle.
      function isValidCommentLikeToggle() {
        let likeDoc = /databases/$(database)/documents/users/$(request.auth.uid)/likedCommentIds/$(commentId);
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1 && existsAfter(likeDoc))
            || (request.resource.data.likeCount == resource.data.likeCount - 1 && !existsAfter(likeDoc))
          );
      }

      allow read: if isSignedIn();
      allow create: if isNewCommentAuthor() && isValidNewComment();
      // Edits and soft-deletes (setting deletedAt) both go through this same
      // branch — only the comment's own author may change content/editedAt/
      // deletedAt; authorId/postId/parentCommentId/createdAt/likeCount are
      // immutable. A non-author may only ever be doing a like toggle.
      allow update: if isValidOwnEdit() || isValidCommentLikeToggle();
      allow delete: if false; // soft-delete only, via the update branch above
    }

    // users/{uid}/likedPostIds/{postId} — existence = this user likes this
    // post. Strictly self-only; only ever created/deleted in the same
    // transaction as the matching posts/{postId}.likeCount step (see
    // isValidLikeToggle above, which is what actually enforces the +1/-1).
    match /users/{uid}/likedPostIds/{postId} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.postId == postId
        && exists(/databases/$(database)/documents/posts/$(postId));
      allow delete: if isOwner();
      allow update: if false;
    }

    // users/{uid}/likedCommentIds/{commentId} — same shape as likedPostIds above.
    match /users/{uid}/likedCommentIds/{commentId} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if isOwner();
      allow create: if isOwner() && request.resource.data.commentId == commentId;
      allow delete: if isOwner();
      allow update: if false;
    }

    // ── Existing collections — BASELINE, see the warning at the top of this file ──
    // Signed-in-only placeholder so this file doesn't default-deny these
    // collections on deploy. Verify against the Firebase Console before
    // deploying — replace with owner-scoped rules if the live rules are
    // stricter than this baseline.

    // BASELINE — users/{uid}: the private profile document (email, age,
    // city, hobbies, ...). Owner-scoped, matching the isOwner() pattern
    // already used by publicProfiles/{uid} above.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // BASELINE — progress/{uid}: streak/session tracking mirrored into
    // publicProfiles/{uid}.currentStreak (see the note on that rule above).
    // Owner-scoped, same pattern as users/{uid} above.
    match /progress/{uid} {
      // Achievements are awarded entirely client-side (see
      // context/ProgressContext.tsx — no Cloud Functions exist in this
      // project to verify them server-side; see the achievement system's
      // final report for the exact `firebase deploy` path if/when that
      // changes). That's a real, acknowledged trust-boundary limitation —
      // the same one already noted for publicProfiles.currentStreak below.
      // What rules *can* enforce without a trusted backend is that the
      // achievements list only ever grows: a client can (already) award
      // itself an achievement it hasn't earned, but it can't use this write
      // path to erase one it — or an earlier version of the client — did
      // legitimately award.
      function achievementsNotShrunk() {
        return request.resource == null
          || resource == null
          || !('state' in resource.data) || !('achievements' in resource.data.state)
          || !('state' in request.resource.data) || !('achievements' in request.resource.data.state)
          || request.resource.data.state.achievements.size() >= resource.data.state.achievements.size();
      }

      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && achievementsNotShrunk();
    }

    // channels/{channelId}/messages/{messageId}: community chat. authorId
    // was added alongside UserCardSheet (Stage 9, so a message author can be
    // opened as a real user card) — messages sent before that field existed
    // have no authorId and are simply not tappable client-side (see
    // app/(tabs)/community.tsx), never a security concern either way since
    // they still can't be edited/deleted by anyone but their own sender.
    match /channels/{channelId}/messages/{messageId} {
      function isSignedIn() { return request.auth != null; }

      function isValidBaseFields(data) {
        return data.authorId == request.auth.uid
          && data.channelId == channelId
          && data.author is string && data.author.size() > 0
          && data.createdAt is string
          && data.text is string && data.text.size() <= 2000;
      }

      // type is a new field — absent entirely on messages sent before this
      // pass, which are always plain text. New messages always set it
      // explicitly to one of "text"/"image"/"sticker".
      function isValidMessageByType(data) {
        return (
          (!('type' in data) || data.type == 'text') && data.text.size() > 0
        ) || (
          data.type == 'image'
          && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1000
          && data.imageStoragePath is string && data.imageStoragePath.size() > 0
        ) || (
          data.type == 'sticker'
          && data.stickerId is string && data.stickerId.size() > 0 && data.stickerId.size() <= 40
        );
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidBaseFields(request.resource.data)
        && isValidMessageByType(request.resource.data)
        && request.resource.data.keys().hasOnly(
          ['channelId', 'authorId', 'author', 'text', 'createdAt', 'type', 'imageUrl', 'imageStoragePath', 'stickerId']
        );

      // Only the sender may delete their own message; legacy messages with
      // no authorId can't be deleted by anyone through this rule (client UI
      // already never shows a delete control for them either).
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      allow update: if false;
    }
  }
}
