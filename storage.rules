rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firebase Storage rules for user profile pictures and post photos.
// Paths are UID-scoped (never username-scoped, since usernames can change),
// matching services/storageService.ts:
//   users/{uid}/avatar/{fileName} — profile picture (one per user)
//   posts/{uid}/{fileName}        — post photos (many per user)
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/avatar/{fileName} {
      // Any signed-in user can view avatars (needed for friend previews and
      // the leaderboard rendering other users' photos).
      allow read: if request.auth != null;

      // Only the owner may upload to their own avatar path, and only an
      // image under 5MB — never another user's path, never a non-image file.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only the owner may remove their own avatar.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /posts/{uid}/{fileName} {
      // Any signed-in user can view post photos (needed to render the feed).
      allow read: if request.auth != null;

      // Only the owner may upload to their own post-photo path, and only an
      // image under 5MB — never another user's path, never a non-image file.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only the owner may remove their own post photos.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
